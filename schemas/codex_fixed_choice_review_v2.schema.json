{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["reviews"],
  "properties": {
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "answers", "case_blueprint", "decision", "rationale"],
        "properties": {
          "candidate_id": {"type": "string"},
          "answers": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_task_matches",
              "evidence_sufficient",
              "independent_result",
              "pre_arrival_work",
              "material_plan_delta",
              "scoreable_consequence",
              "linear_baseline_feasible",
              "answer_leakage",
              "failure_attribution"
            ],
            "properties": {
              "source_task_matches": {"enum": ["yes", "no", "uncertain"]},
              "evidence_sufficient": {"enum": ["yes", "no", "uncertain"]},
              "independent_result": {"enum": ["yes", "no", "uncertain"]},
              "pre_arrival_work": {"enum": ["yes", "designed", "no", "uncertain"]},
              "material_plan_delta": {"enum": ["yes", "no", "uncertain"]},
              "scoreable_consequence": {"enum": ["yes", "no", "uncertain"]},
              "linear_baseline_feasible": {"enum": ["yes", "no", "uncertain"]},
              "answer_leakage": {"enum": ["low", "medium", "high"]},
              "failure_attribution": {"enum": ["model", "benchmark", "infrastructure", "not_failure", "uncertain"]}
            }
          },
          "case_blueprint": {
            "type": "object",
            "additionalProperties": false,
            "required": ["prior_valid_work", "delayed_result", "stale_work", "required_post_result_actions", "async_stressor"],
            "properties": {
              "prior_valid_work": {"type": "array", "items": {"type": "string", "maxLength": 240}, "maxItems": 4},
              "delayed_result": {"type": "string", "maxLength": 500},
              "stale_work": {"type": "array", "items": {"type": "string", "maxLength": 240}, "maxItems": 3},
              "required_post_result_actions": {"type": "array", "items": {"type": "string", "maxLength": 280}, "maxItems": 7},
              "async_stressor": {"type": "string", "maxLength": 500}
            }
          },
          "decision": {"enum": ["accept", "expand_evidence", "reject"]},
          "rationale": {"type": "string", "maxLength": 700}
        }
      }
    }
  }
}
