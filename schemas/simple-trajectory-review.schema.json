{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Async-RBench candidate evidence review",
  "type": "object",
  "required": ["schema_version", "review_id", "source", "task_goal", "evidence_card"],
  "properties": {
    "schema_version": {"const": "2"},
    "review_id": {"type": "string", "minLength": 1},
    "demo_only": {"type": "boolean"},
    "source": {
      "type": "object",
      "required": ["benchmark", "task_id", "trajectory_id"],
      "properties": {
        "benchmark": {"type": "string", "minLength": 1},
        "task_id": {"type": "string", "minLength": 1},
        "trajectory_id": {"type": "string", "minLength": 1}
      }
    },
    "task_goal": {"type": "string", "minLength": 1},
    "evidence_card": {
      "type": "object",
      "required": ["prior_work", "late_information", "affected_action"],
      "properties": {
        "prior_work": {"$ref": "#/$defs/evidenceItem"},
        "late_information": {"$ref": "#/$defs/evidenceItem"},
        "affected_action": {"$ref": "#/$defs/evidenceItem"},
        "expanded_context": {
          "type": "array",
          "items": {"$ref": "#/$defs/excerpt"}
        }
      }
    }
  },
  "$defs": {
    "evidenceItem": {
      "type": "object",
      "required": ["summary", "excerpts"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "excerpts": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/excerpt"}
        }
      }
    },
    "excerpt": {
      "type": "object",
      "required": ["step_id", "actor", "text"],
      "properties": {
        "step_id": {"type": "string", "minLength": 1},
        "actor": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1}
      }
    }
  }
}
