{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["reviews"],
  "properties": {
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unified_candidate_id",
          "decision",
          "semantic_family",
          "independent_boundary",
          "task_specific_affected_work",
          "linear_feasible",
          "same_outcome_scoreable",
          "source_fidelity",
          "source_native_replay_ready",
          "primary_issue",
          "rationale"
        ],
        "properties": {
          "unified_candidate_id": {"type": "string"},
          "decision": {"enum": ["keep_normalized", "rebuild", "reject"]},
          "semantic_family": {
            "enum": [
              "conflicting_specialist_results",
              "cross_app_artifact",
              "dependency_unblock",
              "late_constraint",
              "late_test_evidence",
              "partial_failure_recovery",
              "state_reconciliation",
              "none"
            ]
          },
          "independent_boundary": {"enum": ["yes", "no", "uncertain"]},
          "task_specific_affected_work": {"enum": ["yes", "no", "uncertain"]},
          "linear_feasible": {"enum": ["yes", "no", "uncertain"]},
          "same_outcome_scoreable": {"enum": ["yes", "no", "uncertain"]},
          "source_fidelity": {"enum": ["verified", "incomplete", "broken"]},
          "source_native_replay_ready": {"enum": ["yes", "no", "uncertain"]},
          "primary_issue": {
            "enum": [
              "none",
              "non_independent_event",
              "generic_affected_work",
              "truncated_or_missing_source",
              "unscoreable_outcome",
              "linear_infeasible",
              "source_native_environment_missing",
              "weak_async_causality",
              "duplicate_or_leakage",
              "other"
            ]
          },
          "rationale": {"type": "string", "maxLength": 800}
        }
      }
    }
  }
}
