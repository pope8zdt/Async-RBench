{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Async-RBench trajectory human review",
  "type": "object",
  "required": ["review_id", "task_name", "source", "machine_screen", "agent_coarse_label", "human_review"],
  "properties": {
    "review_id": {"type": "string", "minLength": 1},
    "task_name": {"type": "string", "minLength": 1},
    "source": {"type": "object"},
    "machine_screen": {"type": "object"},
    "agent_coarse_label": {"type": "object"},
    "human_review": {
      "type": "object",
      "required": ["review_decision", "task_match", "version_match", "trajectory_quality", "failure_attribution", "replanning_evidence", "research_events", "recommended_uses", "evidence_step_ids"],
      "properties": {
        "review_decision": {"enum": ["pending", "accept", "revise", "reject"]},
        "task_match": {"enum": ["pending", "yes", "no", "uncertain"]},
        "version_match": {"enum": ["pending", "exact", "instruction_only", "mismatch", "unknown"]},
        "trajectory_quality": {"enum": ["pending", "usable", "partial", "unusable"]},
        "failure_attribution": {"enum": ["pending", "model", "benchmark", "infrastructure", "not_failure", "uncertain"]},
        "replanning_evidence": {"enum": ["pending", "direct", "indirect", "none", "uncertain"]},
        "research_events": {"type": "array", "items": {"enum": ["late_authoritative_result", "conflicting_results", "stale_result_risk", "downstream_invalidation", "selective_preservation", "cancellation", "redelegation", "reverification", "no_research_event"]}, "uniqueItems": true},
        "recommended_uses": {"type": "array", "items": {"enum": ["positive_pattern", "failure_pattern", "counterfactual_source", "topology_source", "test_point_source", "ignore"]}, "uniqueItems": true},
        "evidence_step_ids": {"type": "array", "items": {"type": "integer", "minimum": 0}, "uniqueItems": true},
        "reviewer_note": {"type": "string"}
      }
    }
  }
}
