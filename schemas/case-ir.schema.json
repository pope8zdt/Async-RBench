{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://async-rbench.local/schemas/case-ir.schema.json",
  "title": "Async-RBench task-causal Case IR",
  "type": "object",
  "required": [
    "schema_version", "case_id", "instance_id", "task_archetype",
    "task_requirements", "dependency_graph", "event_contract", "decision_contracts"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "case_id": {"type": "string", "minLength": 1},
    "instance_id": {"type": "string", "minLength": 1},
    "task_archetype": {"type": "string", "minLength": 1},
    "task_requirements": {"type": "array", "minItems": 1},
    "dependency_graph": {"type": "object"},
    "event_contract": {"type": "object"},
    "decision_contracts": {"type": "array", "minItems": 1}
  }
}
