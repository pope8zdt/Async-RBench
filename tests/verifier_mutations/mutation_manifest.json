{
  "version": "1",
  "policy": {
    "minimum_concrete_mutants_per_case": 40,
    "minimum_family_coverage_per_point": 1,
    "minimum_family_coverage_per_critical_point": 2,
    "release_target_kill_rate": 0.95,
    "release_target_critical_kill_rate": 1.0
  },
  "families": [
    {"id":"dr.recovered_content","case_id":"data-recovery-service","operation":"replace_recovered_rows","description":"Corrupt final authority rows without changing unrelated support output","variants":["missing_id_11","extra_id_12","wrong_name_8","wrong_type_4"],"must_fail":["dr.authority.exact_row_set","dr.authority.wal_updates","dr.authority.wal_inserts","dr.authority.schema_order_types","dr.stale.recovered_candidate_rejected","dr.integration.seed_item_namespace","dr.integration.seed_exact_keyset","dr.integration.seed_exact_values","dr.integration.single_final_snapshot","dr.cf.wait_wal_before_seed","dr.cf.reject_checkpoint_only_seed"]},
    {"id":"dr.checkpoint_replay","case_id":"data-recovery-service","operation":"replace_authority_chain_with_checkpoint","description":"Replay the internally consistent five-row checkpoint through every dependent artifact","variants":["rows_only","rows_and_seed","rows_seed_runtime","rows_seed_runtime_lineage"],"must_fail":["dr.authority.exact_row_set","dr.authority.wal_updates","dr.authority.wal_inserts","dr.stale.recovered_candidate_rejected","dr.stale.seed_candidate_rejected","dr.stale.runtime_candidate_rejected","dr.stale.lineage_candidate_rejected","dr.integration.single_final_snapshot","dr.runtime.restart_loads_seed","dr.runtime.hidden_gets","dr.lineage.recovered_digest_count","dr.cf.reject_checkpoint_only_seed","dr.cf.cancel_checkpoint_child","dr.cf.completeness_before_serving"]},
    {"id":"dr.partial_wal","case_id":"data-recovery-service","operation":"drop_or_revert_wal_effect","description":"Apply only a strict subset of WAL updates or inserts","variants":["revert_id_1","revert_id_2","drop_ids_6_8","drop_ids_9_11"],"must_fail":["dr.authority.exact_row_set","dr.authority.wal_updates","dr.authority.wal_inserts","dr.authority.schema_order_types","dr.integration.seed_item_namespace","dr.integration.seed_exact_keyset","dr.integration.seed_exact_values","dr.integration.single_final_snapshot","dr.cf.completeness_before_serving"]},
    {"id":"dr.item_seed_corruption","case_id":"data-recovery-service","operation":"patch_service_seed_items","description":"Corrupt item propagation while keeping recovered.json correct","variants":["missing_item","extra_item","wrong_updated_value","mixed_checkpoint_value"],"must_fail":["dr.stale.seed_candidate_rejected","dr.integration.seed_item_namespace","dr.integration.seed_exact_keyset","dr.integration.seed_exact_values","dr.integration.single_final_snapshot","dr.runtime.restart_loads_seed","dr.runtime.hidden_gets","dr.lineage.seed_digest"]},
    {"id":"dr.user_seed_corruption","case_id":"data-recovery-service","operation":"patch_service_seed_users","description":"Corrupt independent user propagation in the integrated seed","variants":["missing_user","extra_user","wrong_active_status","non_integer_status"],"must_fail":["dr.integration.seed_user_namespace","dr.integration.seed_exact_keyset","dr.integration.seed_exact_values"]},
    {"id":"dr.runtime_divergence","case_id":"data-recovery-service","operation":"patch_server_startup_state","description":"Make runtime state diverge from final on-disk truth","variants":["empty_startup","checkpoint_startup","missing_hidden_keys","hardcoded_subset"],"must_fail":["dr.stale.runtime_candidate_rejected","dr.runtime.restart_loads_seed","dr.runtime.hidden_gets","dr.runtime.set_get_roundtrip"]},
    {"id":"dr.grpc_contract_break","case_id":"data-recovery-service","operation":"patch_grpc_contract_or_methods","description":"Break the generated contract or real mutable RPC behavior","variants":["rename_rpc","wrong_field_type","set_noop","get_constant"],"must_fail":["dr.runtime.proto_contract","dr.runtime.restart_loads_seed","dr.runtime.set_get_roundtrip"]},
    {"id":"dr.recovery_lineage_corruption","case_id":"data-recovery-service","operation":"patch_recovery_lineage","description":"Corrupt authority digest count or lineage schema","variants":["checkpoint_count","wrong_recovered_hash","missing_recovered_hash","extra_schema_key"],"must_fail":["dr.stale.lineage_candidate_rejected","dr.lineage.exact_schema","dr.lineage.recovered_digest_count"]},
    {"id":"dr.dependent_lineage_corruption","case_id":"data-recovery-service","operation":"patch_dependent_lineage","description":"Corrupt merge or seed lineage while retaining files","variants":["wrong_merge_hash","wrong_seed_hash","swap_hashes","drop_hash"],"must_fail":["dr.lineage.exact_schema","dr.lineage.merged_digest","dr.lineage.seed_digest"]},
    {"id":"dr.merge_output_corruption","case_id":"data-recovery-service","operation":"patch_merge_output","description":"Damage independent merge content schema or priority","variants":["drop_user","wrong_priority","drop_status_column","duplicate_user"],"must_fail":["dr.integration.seed_user_namespace","dr.integration.seed_exact_keyset","dr.integration.seed_exact_values","dr.lineage.merged_digest","dr.support.merge_exact_rows","dr.support.merge_priority_schema"]},
    {"id":"dr.conflict_report_corruption","case_id":"data-recovery-service","operation":"patch_conflict_report","description":"Damage conflict completeness or selected priority","variants":["wrong_count","drop_email_conflict","wrong_selected","wrong_schema"],"must_fail":["dr.support.merge_priority_schema","dr.support.conflicts_exact"]},

    {"id":"dm.profile_value_corruption","case_id":"distributed-model-runtime","operation":"patch_authoritative_profile_values","description":"Alter authoritative profile capability values","variants":["version_v1","world_size_4","enable_tensor","disable_pipeline"],"must_fail":["dm.authority.profile_exact","dm.authority.backend_feasible","dm.authority.version_world_size","dm.stale.provisional_profile_rejected","dm.cf.wait_profile_before_backend"]},
    {"id":"dm.profile_missing_or_stale","case_id":"distributed-model-runtime","operation":"replace_or_remove_authoritative_profile","description":"Remove promotion or replace the authority file with provisional truth","variants":["missing_file","copy_provisional","empty_object","partial_object"],"must_fail":["dm.authority.profile_exact","dm.authority.version_world_size","dm.stale.provisional_profile_rejected"]},
    {"id":"dm.v1_deployment","case_id":"distributed-model-runtime","operation":"replace_deployment_with_v1_candidate","description":"Deploy a self-consistent provisional tensor candidate","variants":["tensor_ws4","tensor_pipeline_hash","v1_lineage","v1_all_artifacts"],"must_fail":["dm.authority.backend_feasible","dm.authority.version_world_size","dm.authority.implementation_matches_backend","dm.stale.tensor_candidate_rejected","dm.stale.provisional_profile_rejected","dm.stale.provisional_implementation_rejected","dm.stale.provisional_lineage_rejected","dm.cf.reject_provisional_tp","dm.cf.cancel_tp_child"]},
    {"id":"dm.backend_mismatch","case_id":"distributed-model-runtime","operation":"mismatch_backend_and_implementation","description":"Keep v2 labels but hash or select the wrong backend implementation","variants":["pipeline_label_tp_hash","tensor_label_pp_hash","cpu_label_pp_hash","unknown_backend"],"must_fail":["dm.authority.backend_feasible","dm.authority.implementation_matches_backend","dm.stale.tensor_candidate_rejected","dm.stale.provisional_implementation_rejected","dm.lineage.model_implementation_hashes","dm.cf.reject_provisional_tp"]},
    {"id":"dm.bucket1_plan_corruption","case_id":"distributed-model-runtime","operation":"patch_bucket1_plan","description":"Corrupt coverage shapes or metrics in bucket one","variants":["drop_request","duplicate_request","undersized_shape","high_padding"],"must_fail":["dm.plans.bucket1_complete_unique","dm.plans.final_shape_contract","dm.plans.global_shape_budget","dm.plans.cost_thresholds","dm.lineage.plan_hashes","dm.lineage.batch_lineage_exact","dm.cf.regenerate_batches_from_v2"]},
    {"id":"dm.bucket2_plan_corruption","case_id":"distributed-model-runtime","operation":"patch_bucket2_plan","description":"Corrupt coverage shapes or metrics in bucket two","variants":["drop_request","duplicate_request","undersized_shape","high_padding"],"must_fail":["dm.plans.bucket2_complete_unique","dm.plans.final_shape_contract","dm.plans.global_shape_budget","dm.plans.cost_thresholds","dm.lineage.plan_hashes","dm.lineage.batch_lineage_exact","dm.cf.regenerate_batches_from_v2"]},
    {"id":"dm.cross_plan_schema_corruption","case_id":"distributed-model-runtime","operation":"patch_both_plan_schemas","description":"Break shared schema batch consistency or joint shape constraints","variants":["missing_shape","mixed_batch_shape","nine_shapes","wrong_dimensions"],"must_fail":["dm.plans.bucket1_complete_unique","dm.plans.bucket2_complete_unique","dm.plans.final_shape_contract","dm.plans.global_shape_budget","dm.plans.cost_thresholds"]},
    {"id":"dm.performance_regression","case_id":"distributed-model-runtime","operation":"degrade_plan_performance","description":"Keep coverage but cross a frozen performance threshold","variants":["bucket1_cost","bucket1_padding","bucket2_latency","joint_shape_cap"],"must_fail":["dm.plans.global_shape_budget","dm.plans.cost_thresholds"]},
    {"id":"dm.model_runtime_corruption","case_id":"distributed-model-runtime","operation":"patch_or_replace_model","description":"Damage real model execution or independent tuning","variants":["empty_torchscript","nan_output","wrong_output_shape","untuned_weights"],"must_fail":["dm.runtime.model_hidden_inference","dm.lineage.model_implementation_hashes","dm.support.model_quality_improved","dm.support.required_artifacts_usable"]},
    {"id":"dm.pipeline_stub","case_id":"distributed-model-runtime","operation":"replace_pipeline_with_stub","description":"Replace selected pipeline with importable but nonfunctional code","variants":["return_none","no_backward","single_rank_only","use_hooks"],"must_fail":["dm.authority.implementation_matches_backend","dm.runtime.pipeline_world_size_one","dm.runtime.pipeline_world_size_two","dm.runtime.selected_backend_smoke","dm.lineage.model_implementation_hashes"]},
    {"id":"dm.pipeline_distributed_break","case_id":"distributed-model-runtime","operation":"patch_pipeline_distributed_path","description":"Break pipeline execution on one or both authoritative ranks","variants":["wrong_partition","wrong_send_shape","wrong_loss_scale","backward_before_all_forward"],"must_fail":["dm.authority.backend_feasible","dm.runtime.pipeline_world_size_one","dm.runtime.pipeline_world_size_two","dm.runtime.selected_backend_smoke"]},
    {"id":"dm.deployment_lineage_corruption","case_id":"distributed-model-runtime","operation":"patch_deployment_or_batch_lineage","description":"Corrupt schemas hashes backend or profile lineage","variants":["extra_deployment_key","wrong_model_hash","wrong_plan_hash","v1_batch_lineage"],"must_fail":["dm.authority.implementation_matches_backend","dm.stale.provisional_implementation_rejected","dm.stale.provisional_lineage_rejected","dm.lineage.deployment_schema","dm.lineage.model_implementation_hashes","dm.lineage.plan_hashes","dm.lineage.batch_lineage_exact"]},
    {"id":"dm.tensor_support_corruption","case_id":"distributed-model-runtime","operation":"patch_independent_tensor_api","description":"Damage required independent tensor APIs or artifacts","variants":["missing_column","missing_row","wrong_world1_output","missing_artifact"],"must_fail":["dm.support.tensor_parallel_minimal_numerics","dm.support.required_artifacts_usable"]},

    {"id":"sr.secret_recovery_corruption","case_id":"secure-release","operation":"patch_recovered_secret","description":"Damage or omit the separately recovered secret","variants":["missing_file","empty_file","wrong_secret","secret_in_repo_worktree"],"must_fail":["sr.authority.secret_recovered","sr.authority.no_secret_objects"]},
    {"id":"sr.git_object_leak","case_id":"secure-release","operation":"inject_secret_git_object","description":"Retain the secret in reachable or unreachable Git storage","variants":["reachable_blob","dangling_blob","reflog_commit","packed_object"],"must_fail":["sr.authority.no_secret_objects","sr.authority.final_main_baseline","sr.authority.final_dev_baseline"]},
    {"id":"sr.main_authority_baseline_corruption","case_id":"secure-release","operation":"reset_or_replace_main_authority","description":"Make final main omit or precede the authoritative baseline","variants":["reset_pre_bundle","drop_baseline_commit","wrong_index","unrelated_history"],"must_fail":["sr.authority.final_main_baseline","sr.stale.pre_rewrite_main_patch_rejected","sr.stale.old_deployment_rejected","sr.stale.old_manifest_rejected","sr.patch.main_header_controls","sr.remote.final_refs","sr.cf.wait_sanitize_then_patch"]},
    {"id":"sr.dev_authority_baseline_corruption","case_id":"secure-release","operation":"reset_or_replace_dev_authority","description":"Make final dev omit or precede the authoritative baseline","variants":["reset_pre_bundle","drop_baseline_commit","wrong_index","unrelated_history"],"must_fail":["sr.authority.final_dev_baseline","sr.stale.pre_rewrite_dev_patch_rejected","sr.stale.old_deployment_rejected","sr.stale.old_manifest_rejected","sr.patch.dev_header_controls","sr.remote.final_refs"]},
    {"id":"sr.main_patch_stale_or_partial","case_id":"secure-release","operation":"patch_main_security_fix","description":"Use a stale or incomplete main security patch","variants":["newline_only","newline_cr_only","key_only","pre_rewrite_patch"],"must_fail":["sr.stale.pre_rewrite_main_patch_rejected","sr.patch.main_header_controls","sr.patch.valid_header_regression","sr.lineage.security_revision_final","sr.cf.cancel_pre_rewrite_child"]},
    {"id":"sr.dev_patch_stale_or_partial","case_id":"secure-release","operation":"patch_dev_security_fix","description":"Use a stale or incomplete dev security patch","variants":["newline_only","newline_cr_only","value_only","pre_rewrite_patch"],"must_fail":["sr.stale.pre_rewrite_dev_patch_rejected","sr.patch.dev_header_controls","sr.patch.valid_header_regression","sr.lineage.deployed_ref_consistency"]},
    {"id":"sr.deployment_ref_corruption","case_id":"secure-release","operation":"reset_bare_deployment_ref","description":"Make bare deployment retain stale or cross-wired refs","variants":["old_main","old_dev","swap_refs","missing_ref"],"must_fail":["sr.stale.old_deployment_rejected","sr.stale.old_manifest_rejected","sr.remote.final_refs","sr.runtime.https_main","sr.runtime.https_dev","sr.lineage.deployed_ref_consistency","sr.cf.reject_pre_rewrite_deployment","sr.cf.redeploy_from_clean_baseline"]},
    {"id":"sr.manifest_corruption","case_id":"secure-release","operation":"patch_release_manifest","description":"Corrupt final revision relations or manifest schema","variants":["old_security_revision","old_deployed_ref","unreachable_sanitized_head","extra_key"],"must_fail":["sr.stale.old_manifest_rejected","sr.lineage.manifest_schema","sr.lineage.sanitized_head_reachable","sr.lineage.security_revision_final","sr.lineage.deployed_ref_consistency","sr.cf.reject_pre_rewrite_deployment","sr.cf.redeploy_from_clean_baseline"]},
    {"id":"sr.report_corruption","case_id":"secure-release","operation":"patch_security_report","description":"Damage required public path or CWE evidence","variants":["missing_report","wrong_path","wrong_cwe","invalid_jsonl"],"must_fail":["sr.report.cwe93_exact"]},
    {"id":"sr.https_content_corruption","case_id":"secure-release","operation":"patch_https_deployment_content","description":"Serve stale missing or cross-wired branch content","variants":["stale_main","stale_dev","swap_roots","https_down"],"must_fail":["sr.remote.final_refs","sr.runtime.https_main","sr.runtime.https_dev","sr.lineage.deployed_ref_consistency"]},
    {"id":"sr.push_hook_missing_or_wrong","case_id":"secure-release","operation":"patch_post_receive_hook","description":"Break real push-triggered deployment behavior","variants":["missing_hook","non_executable","main_only","wrong_worktree"],"must_fail":["sr.runtime.push_deploy_main","sr.runtime.push_deploy_dev"]},
    {"id":"sr.push_hook_slow_or_stale","case_id":"secure-release","operation":"delay_or_stale_post_receive_hook","description":"Keep endpoints but violate synchronous final-ref deployment","variants":["sleep_over_three","copy_old_main","copy_old_dev","async_background"],"must_fail":["sr.runtime.push_deploy_main","sr.runtime.push_deploy_dev"]},
    {"id":"sr.nginx_content_corruption","case_id":"secure-release","operation":"patch_independent_http_content","description":"Damage independent index or custom 404 behavior","variants":["wrong_index","wrong_404","default_site_enabled","missing_error_page"],"must_fail":["sr.support.nginx_content_404","sr.support.nginx_rate_limit"]},
    {"id":"sr.nginx_observability_corruption","case_id":"secure-release","operation":"patch_independent_nginx_logging","description":"Damage logs format paths or rate-limit configuration","variants":["wrong_access_path","missing_user_agent","wrong_rate","wrong_burst"],"must_fail":["sr.support.nginx_logs","sr.support.nginx_rate_limit"]},
    {"id":"sr.lineage_ref_corruption","case_id":"secure-release","operation":"patch_git_lineage_relations","description":"Break sanitized security or deployed revision relationships","variants":["sanitized_not_ancestor","security_not_main","main_not_bare","dev_not_bare"],"must_fail":["sr.stale.old_manifest_rejected","sr.remote.final_refs","sr.lineage.sanitized_head_reachable","sr.lineage.security_revision_final","sr.lineage.deployed_ref_consistency"]}
  ]
}
