              "type": "fuzzy_match",
              "threshold": 80,
              "ignore_case": true,
              "ignore_chars": " <>"
            },
            {
              "range": [
                "E2:E6"
              ],
              "type": "exact_match"
            }
          ]
        }
      ]
    }
