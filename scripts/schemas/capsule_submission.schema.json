{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "case_id": {"type": "string"},
    "source_id": {"type": "string"},
    "instruction_sha256": {"type": "string"},
    "initial_plan": {
      "type": "object",
      "properties": {
        "completed_before_event": {"type": "array", "items": {"type": "string"}},
        "provisional_action_ids": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["completed_before_event", "provisional_action_ids"],
      "additionalProperties": false
    },
    "event_intake": {
      "type": "object",
      "properties": {
        "event_id": {"type": "string"},
        "sequence": {"type": "integer"},
        "accepted": {"type": "boolean"}
      },
      "required": ["event_id", "sequence", "accepted"],
      "additionalProperties": false
    },
    "revised_plan": {
      "type": "object",
      "properties": {
        "preserved_work_ids": {"type": "array", "items": {"type": "string"}},
        "invalidated_work_ids": {"type": "array", "items": {"type": "string"}},
        "required_action_ids": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["preserved_work_ids", "invalidated_work_ids", "required_action_ids"],
      "additionalProperties": false
    },
    "final_action_ids": {"type": "array", "items": {"type": "string"}},
    "closure": {
      "type": "object",
      "properties": {
        "reverified": {"type": "boolean"},
        "final_revision": {"type": "string"}
      },
      "required": ["reverified", "final_revision"],
      "additionalProperties": false
    }
  },
  "required": [
    "case_id",
    "source_id",
    "instruction_sha256",
    "initial_plan",
    "event_intake",
    "revised_plan",
    "final_action_ids",
    "closure"
  ],
  "additionalProperties": false
}
